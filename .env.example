# Example .env for nextjs-dashboard
# Two variants included: host (app on host) and container (app inside compose network).
# Replace values with your secrets before using in production.

# --- Host (connect to mapped port) ---
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=mydb

# Connection URL used by the app (uncomment and set for your environment)
POSTGRES_URL="postgres://user:password@localhost:5432/mydb"
# Toggle SSL when connecting to Postgres (set to 'true' to enable)
POSTGRES_SSL=false

# Optional single connection string (uncomment if your app uses it)
#DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Container network (app runs in same docker-compose) ---
#PGHOST=postgres
#PGPORT=5432
#PGUSER=user
#PGPASSWORD=password
#PGDATABASE=mydb
#DATABASE_URL="postgresql://user:password@postgres:5432/mydb"

# pgAdmin credentials (optional)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminpassword
